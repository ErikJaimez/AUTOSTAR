{
  "name": "autostar-backend",
  "version": "1.0.0",
  "description": "Backend API REST para la plataforma AUTOSTAR - Escuela de Manejo",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
