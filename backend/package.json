    "dotenv": "16.4.5",
    "express": "4.21.0",
    "express-validator": "7.2.0",
    "jsonwebtoken": "9.0.2",
    "knex": "3.1.0",
    "nodemailer": "^6.9.15",
    "pg": "8.13.0"
  },
  "devDependencies": {
    "fast-check": "3.22.0",
    "nodemon": "3.1.7",
    "vitest": "2.1.1"
  }
}
